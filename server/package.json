{
  "name": "orijin-server",
  "version": "0.0.1",
  "description": "",
  "author": "Teemu & Salla",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "nest": "nest",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "prisma:db:push": "prisma db push",
    "prisma:db:studio": "prisma studio",
    "prisma:migrate:dev": "prisma migrate dev --preview-feature && git add ./prisma/migrations",
    "prisma:migrate:reset": "prisma migrate reset --preview-feature --force",
    "prisma:migrate:deploy": "prisma migrate deploy --preview-feature",
    "prisma:migrate:status": "prisma migrate status --preview-feature",
    "prisma:migrate:resolve": "prisma migrate resolve --preview-feature",
    "prisma:studio": "prisma studio",
    "prisma:generate": "prisma generate",
    "prisma:generate:watch": "prisma generate --watch",
    "prisma:format": "prisma format",
    "prisma:seed": "prisma db seed",
    "prisma:init:db": "npm run prisma:migrate:up && npm run prisma:generate && npm run seed",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e:local": "dotenv -e .env -o -e .env.tests -- prisma migrate deploy && dotenv -e .env -o -e .env.tests -- jest --config ./test/jest-e2e.json --verbose=true --detectOpenHandles -- farmsAndPlots",
    "test:e2e:local:reset": "dotenv -e .env -o -e .env.tests -- prisma migrate reset --force",
    "test:e2e:ci": "prisma migrate deploy && jest --config ./test/jest-e2e.json --verbose=true",
    "postinstall": "npm run prisma:generate",
    "docker:migrate": "docker-compose -f docker-compose.migrate.yml up -d",
    "docker:db": "docker-compose -f docker-compose.db.yml up -d",
    "docker:seed": "docker exec -it orijin-api npm run seed",
    "docker": "docker-compose up -d",
    "docker:build": "docker-compose build",
    "scripts:importFirestore": "ts-node src/scripts/importFirestore.ts",
    "scripts:importFirestore:reset": "npm run prisma:migrate:reset --force && npm run scripts:importFirestore",
    "scripts:importExcel": "ts-node src/scripts/importExcel.ts",
    "scripts:runAnalysis": "ts-node src/scripts/runAnalysis.ts",
    "scripts:geoCledian:analysePolygons": "ts-node src/scripts/analysePolygons.ts",
    "scripts:geoCledian:getResult": "ts-node src/scripts/getGeocledianResult.ts",
    "scripts:getLtcPolygonsAsFarmInspections": "ts-node src/scripts/getLtcPolygonsAsFarmInspections.ts",
    "scripts:checkPolygonsFromFirestore": "ts-node src/scripts/checkPolygonsFromFirestore.ts",
    "scripts:exportDataToFireStore": "ts-node src/scripts/exportDataToFireStore.ts",
    "scripts:resetDbAndExportToFirebase": "ts-node src/scripts/resetDbAndExportToFirebase.ts",
    "scripts:importCsv": "ts-node src/scripts/importCsv.ts",
    "scripts:cleanDataForOrg": "ts-node src/scripts/cleanDataForOrg.ts",
    "scripts:exportMissingDataToFireStore": "ts-node src/scripts/exportMissingDataToFireStore.ts",
    "scripts:exportGeoJson": "ts-node src/scripts/exportGeoJson.script.ts",
    "scripts:reCalculateAutofixes": "ts-node src/scripts/reCalculateAutofixes.ts",
    "scripts:reCalculateInteractionWarnings": "ts-node src/scripts/reCalculateInteractionWarnings.ts",
    "scripts:fixIncomingPayloads": "ts-node src/scripts/fixIncomingPayloads.ts",
    "######:PROD:SCRIPTS:######": "echo 'Tread carefully'",
    "PROD:scripts:geoCledian:analysePolygons": "dotenv -e .env -o -e .env.prod -- ts-node src/scripts/analysePolygons.ts",
    "PROD:scripts:geoCledian:getResult": "dotenv -e .env -o -e .env.prod -- ts-node src/scripts/getGeocledianResult.ts",
    "PROD:scripts:exportGeoJson": "dotenv -e .env -o -e .env.prod -- ts-node src/scripts/exportGeoJson.script.ts",
    "PROD:scripts:getLtcPolygonsAsFarmInspections": "dotenv -e .env -o -e .env.prod -- ts-node src/scripts/getLtcPolygonsAsFarmInspections.ts",
    "PROD:scripts:checkPolygonsFromFirestore": "dotenv -e .env -o -e .env.prod -- ts-node src/scripts/checkPolygonsFromFirestore.ts",
    "PROD:scripts:importExcel": "dotenv -e .env -o -e .env.prod -- ts-node src/scripts/importExcel.ts",
    "PROD:scripts:importCsv": "dotenv -e .env -o -e .env.prod -- ts-node src/scripts/importCsv.ts",
    "PROD:scripts:exportMissingDataToFireStore": "dotenv -e .env -o -e .env.prod -- ts-node src/scripts/exportMissingDataToFireStore.ts",
    "PROD:scripts:exportDataToFireStore": "dotenv -e .env -o -e .env.prod -- ts-node src/scripts/exportDataToFireStore.ts",
    "PROD:scripts:reCalculateAutofixes": "dotenv -e .env -o -e .env.prod -- ts-node src/scripts/reCalculateAutofixes.ts",
    "PROD:scripts:reCalculateInteractionWarnings": "dotenv -e .env -o -e .env.prod -- ts-node src/scripts/reCalculateInteractionWarnings.ts"
  },
  "dependencies": {
    "@apollo/server": "^4.7.5",
    "@devoxa/prisma-relay-cursor-connection": "2.2.3",
    "@nestjs/apollo": "12.0.7",
    "@nestjs/axios": "^3.0.2",
    "@nestjs/common": "10.1.0",
    "@nestjs/config": "3.0.0",
    "@nestjs/core": "10.1.0",
    "@nestjs/graphql": "12.0.8",
    "@nestjs/jwt": "10.1.0",
    "@nestjs/passport": "10.0.0",
    "@nestjs/platform-express": "10.1.0",
    "@nestjs/swagger": "7.1.2",
    "@prisma/client": "^5.18.0",
    "@sendgrid/mail": "^8.1.3",
    "@turf/turf": "^6.5.0",
    "@types/geojson": "^7946.0.14",
    "axios": "^1.6.8",
    "bcrypt": "5.1.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.13.2",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "dotenv-cli": "^7.4.1",
    "fast-xml-parser": "^4.4.0",
    "firebase-admin": "^12.0.0",
    "geojson": "^0.5.0",
    "graphql": "16.7.1",
    "graphql-scalars": "1.22.2",
    "graphql-subscriptions": "2.0.0",
    "mathjs": "^13.0.3",
    "nestjs-prisma": "0.23",
    "object-path": "^0.11.8",
    "papaparse": "^5.4.1",
    "passport": "0.6.0",
    "passport-jwt": "4.0.1",
    "reflect-metadata": "0.1.13",
    "rxjs": "7.8.1",
    "source-map-support": "^0.5.21",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@automock/adapters.nestjs": "^2.1.0",
    "@automock/jest": "^2.1.0",
    "@nestjs/cli": "10.1.10",
    "@nestjs/schematics": "10.0.1",
    "@nestjs/testing": "10.1.0",
    "@swc/cli": "^0.1.62",
    "@swc/core": "^1.3.70",
    "@types/bcrypt": "5.0.0",
    "@types/chance": "1.1.3",
    "@types/dotenv": "^8.2.0",
    "@types/express": "4.17.17",
    "@types/jest": "^29.5.3",
    "@types/node": "^20.3.1",
    "@types/object-path": "^0.11.4",
    "@types/supertest": "2.0.12",
    "@typescript-eslint/eslint-plugin": "^5.59.11",
    "@typescript-eslint/parser": "^5.59.11",
    "chance": "1.1.11",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^4.2.1",
    "jest": "29.6.1",
    "prettier": "2.8.8",
    "prisma": "^5.18.0",
    "prisma-dbml-generator": "0.12.0",
    "supertest": "6.3.3",
    "ts-jest": "29.1.1",
    "ts-loader": "9.4.4",
    "ts-node": "10.9.1",
    "tsconfig-paths": "4.2.0",
    "typescript": "^5.1.6"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
