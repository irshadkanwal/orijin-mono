  approvals Approval [not null]
}

Table ActivitySubmit {
  id String [pk]
  organisation String [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  deletedAt DateTime
  createdBy User [not null]
  createdById String [not null]
  rawData Json
  approvals Approval [not null]
  lot Lot [not null]
  lotId String [not null]
  processingPropertiesId String
}

Table Approval {
  id String [pk]
  organisation String [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  deletedAt DateTime
  type String [not null]
  status String
  note String
  documents Document [not null]
  user User [not null]
  userId String [not null]
  lot Lot
  lotId String
  activitySubmit ActivitySubmit
  activitySubmitId String
}

Table PaymentTransaction {
  id String [pk]
  organisation String [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  deletedAt DateTime
  status String [not null]
  externalStatus String [not null]
  externalId String [not null]
  accountId String
  payeeFirstName String [not null]
  payeeLastName String [not null]
  type String [not null]
  paymentDate DateTime [not null]
  weight Decimal [not null]
  weightUnit String [not null]
  amount Decimal [not null]
  currency String [not null]
  conversionToUSD Decimal [not null]
  lot Lot [not null]
  lotId String [unique, not null]
  farm Farm
  farmId String
  person Person
  personId String
  wallet Wallet
  walletId String
  errorMsg String
}

Table Vessel {
  id String [pk]
  shortCode String
  organisation String [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  deletedAt DateTime
  name String [not null]
  type String [not null]
  subType String [not null]
  description String
  permanent Boolean
  size Decimal
  weight Decimal
  facility Facility
  facilityId String
  plot Plot
  plotId String

  indexes {
    (shortCode, organisation) [unique]
  }
}

Table createdByUser {
  surveyresultscreatedId String [ref: > SurveyResult.id]
  surveyscreatedId String [ref: > Survey.id]
}

Table updatedByUser {
  surveyresultsupdatedId String [ref: > SurveyResult.id]
  surveysupdatedId String [ref: > Survey.id]
}

Table LocationToTag {
  usedbylocationsId String [ref: > Location.id]
  tagsId String [ref: > Tag.id]
}

Table FacilityToTag {
  usedbyfacilitiesId String [ref: > Facility.id]
  tagsId String [ref: > Tag.id]
}

Table CropToPlot {
  usedbyplotsId String [ref: > Plot.id]
  secondarycropsId String [ref: > Crop.id]
}

Table CropVarietyToPlot {
  usedbyplotsId String [ref: > Plot.id]
  mainvarietiesId String [ref: > CropVariety.id]
}

Table CertificationTypeToProduct {
  productsId String [ref: > Product.id]
  certificationtypesId String [ref: > CertificationType.id]
}

Table AuditActivityToCertificationType {
  auditactivitiesId String [ref: > AuditActivity.id]
  scopeId String [ref: > CertificationType.id]
}

Table FacilityToProduct {
  originfacilitiesId String [ref: > Facility.id]
  usedasoriginfacilityforproductsId String [ref: > Product.id]
}

Table FarmToProduct {
  originfarmsId String [ref: > Farm.id]
  usedasoriginfarmforproductsId String [ref: > Product.id]
}

Table polygonInteractionWarnings {
  polygoninteractionwarningsId String [ref: > PolygonInteractionWarning.id]
  polygonsId String [ref: > Polygon.id]
}

Table AuditActivityToCertification {
  auditactivitiesId String [ref: > AuditActivity.id]
  conductedforcertificationsId String [ref: > Certification.id]
}

